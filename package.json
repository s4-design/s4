{
    "name": "s4",
    "version": "1.2.0",
    "packageManager": "pnpm@11.9.0",
    "description": "Кодо-центричная среда для построения дизайн-систем",
    "keywords": [
        "s4",
        "design-system",
        "css-framework",
        "utility-classes",
        "preset",
        "css-logical-properties",
        "scss",
        "device-specific",
        "ai-friendly"
    ],
    "author": {
        "name": "Артур А. Селимов",
        "email": "info@mobitoon.ru",
        "url": "http://mobitoon.ru"
    },
    "license": "SEE LICENSE IN LICENSE",
    "homepage": "https://github.com/s4-design/s4",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/s4-design/s4.git"
    },
    "scripts": {
        "_header-update": "node header.update.js",
        "_dev-scss": "sass --watch src/scss:s4/css --no-source-map",
        "test": "node test/snapshot.mjs",
        "test-update": "node test/snapshot.mjs --update",
        "check-docs": "node test/check-docs.mjs",
        "lint": "pnpm lint:js && pnpm lint:css",
        "lint:js": "eslint src/js",
        "lint:css": "stylelint \"src/scss/**/*.scss\"",
        "_s4-scss": "sass src/scss:s4/css --no-source-map --style=compressed --no-charset",
        "_s4-js": "terser src/js/s4.js --output s4/js/s4.min.js --mangle",
        "_s4-index": "node s4-index.mjs",
        "s4": "pnpm _s4-scss && pnpm _s4-js && pnpm _s4-index && pnpm _header-update && pnpm check-docs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "concurrently": "^9.2.1",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "nodemon": "^3.1.0",
        "pixelmatch": "^7.2.0",
        "playwright": "^1.60.0",
        "pngjs": "^7.0.0",
        "postcss-scss": "^4.0.9",
        "sass": "^1.99.0",
        "stylelint": "^17.16.0",
        "stylelint-scss": "^7.3.0",
        "terser": "^5.46.1"
    }
}
