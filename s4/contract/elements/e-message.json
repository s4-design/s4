{
  "тег": "e-message",
  "классДубликат": "element--message",
  "описание": "Сообщение пользователю с цветовым акцентом: статус, уведомление или предупреждение.",
  "модификаторы": [
    "negative",
    "prime",
    "second",
    "success",
    "danger"
  ],
  "Дети": {
    "header": {
      "тег": "header",
      "классДубликат": null,
      "обязательный": false,
      "примечание": "заголовок сообщения"
    },
    "e-body": {
      "тег": "e-body",
      "классДубликат": "element--body",
      "обязательный": true,
      "примечание": "тело сообщения"
    },
    "footer": {
      "тег": "footer",
      "классДубликат": null,
      "обязательный": false,
      "примечание": "действия (кнопки)"
    },
    "порядок": [
      ["header", "e-body", "footer"],
      ["header", "e-body"],
      ["e-body", "footer"],
      ["e-body"]
    ]
  },
  "роли": {
    "status": {
      "модификаторы": [
        "negative",
        "prime",
        "second",
        "success"
      ],
      "когда": "Цветовой акцент статуса/уведомления (negative/prime/second/success)."
    },
    "alert": {
      "модификаторы": [
        "danger"
      ],
      "когда": "Цветовой акцент опасности/предупреждения (danger)."
    }
  },
  "допустимыйКонтент": {
    "примечание": "Внутри e-body - любой flow-контент; в header/footer - текст, кнопки, e-icon.",
    "примеры": [
      "e-body",
      "header",
      "footer",
      "e-icon",
      "button",
      "p",
      "ul/ol",
      "img"
    ]
  },
  "запрещено": {
    "элементы": [
      "вложенный e-message",
      "несколько e-body",
      "несколько модификаторов одновременно (взаимоисключающие)"
    ],
    "роли": [
      "роли без цветового модификатора (роль выводится из модификатора)"
    ]
  }
}
